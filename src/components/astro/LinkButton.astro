---
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  kind?: "primary" | "secondary";
}

const { class: className, kind = "secondary", ...props } = Astro.props;
---

<style>
  a {
    background: linear-gradient(rgba(255, 255, 255, 0.25), rgba(0, 0, 0, 0.25));
    text-decoration: none;
    border: none;
    cursor: pointer;
    font: var(--font_body);
    height: 48px;
    padding: 0 12px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border-radius: 8px;
    opacity: 0.85;
    transition:
      transform 1s,
      opacity 1s;
    transition-timing-function: var(--spring-interpolation);

    :first-child {
      transition: transform 1s var(--spring-interpolation);
    }

    @media (hover: hover) {
      &:hover {
        opacity: 1;
      }
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      &:hover {
        transform: scaleX(0.95) scaleY(1.1);

        :first-child {
          transform: scaleX(1.2) scaleY(1.1) rotate(-15deg);
        }
      }
    }

    &:active {
      opacity: 0.6;
    }

    @media (prefers-reduced-motion: no-preference) {
      &:active {
        transform: scaleX(1.1) scaleY(0.95);
      }
    }

    &.secondary {
      background-color: var(--color_background-light);
      color: var(--color_text-white);
    }

    &.primary {
      background-color: var(--color_accent-yellow);
      color: var(--color_text-black);
    }
  }
</style>
<a {...props} class:list={[className, kind]}>
  <slot name="left" />
  <slot />
  <slot name="right" />
</a>
